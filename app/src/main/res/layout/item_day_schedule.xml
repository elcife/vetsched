<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <TextView
            android:id="@+id/tvDayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monday"
            android:textColor="@color/vetsched_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActiveClasses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 Active Classes"
            android:textColor="@color/vetsched_text_hint"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/view_timeline_row" android:id="@+id/row7" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row8" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row9" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row10" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row11" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row12" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row1" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row2" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row3" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row4" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row5" />
                <include layout="@layout/view_timeline_row" android:id="@+id/row6" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>