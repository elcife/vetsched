<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vetsched_background">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monday"
        android:textColor="@color/vetsched_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <HorizontalScrollView
        android:id="@+id/dateSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabMon"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_date_selected"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMonLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMonDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabTue"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_date_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTueLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tue"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabWed"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_date_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wed"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvWedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabThu"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_date_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvThuLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thu"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvThuDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabFri"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_date_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFriLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fri"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFriDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSat"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_date_unselected"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sat"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSatDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="31"
                    android:textColor="@color/vetsched_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnYesSubmit"
        app:layout_constraintTop_toBottomOf="@id/dateSelector" />

    <Button
        android:id="@+id/btnYesSubmit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#B0B0B0"
        android:enabled="false"
        android:text="Yes, Submit Schedule"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>